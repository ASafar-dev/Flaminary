{
  "expo": {
    "name": "Flaminary",
    "slug": "flaminary",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/flaminary-icon.png",
    "scheme": "flaminary",
    "userInterfaceStyle": "light",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3F5F8",
        "foregroundImage": "./assets/images/flaminary-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/flaminary-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F5F8",
          "image": "./assets/images/flaminary-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
